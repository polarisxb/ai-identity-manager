# Copy this file to proxy-secret.local and fill in real values.
# proxy-secret.local is gitignored. Do not commit it.

PROXY_HOST=
PROXY_HTTP_PORT=
PROXY_SOCKS_PORT=
PROXY_USER=
PROXY_PASS=

# Optional test settings.
TEST_URL=https://ipinfo.io
LONG_IDLE_SECONDS=360
BOOTSTRAP_PROXY=http://127.0.0.1:7889

# Exit identity expectations (required for verify/monitor to judge GREEN).
EXPECTED_EXIT_IP=
EXPECTED_ASN=
EXPECTED_COUNTRY=

# Must equal `secret:` in clash-verge.yaml. Used as Bearer token on the controller.
CONTROLLER_SECRET=
